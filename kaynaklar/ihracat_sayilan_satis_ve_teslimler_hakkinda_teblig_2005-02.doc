  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'> </span><span
  style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'>5)
  İşçilik-Personel</span><span style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'>6)
  Yakıt-Enerji-Su</span><span style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'>7)
  Bakım ve Onarım</span><span style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'>8)
  Genel Giderler</span><span style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'>9)
  Faiz-Komisyon</span><span style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'>10)
  Amortismanlar</span><span style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'>11)
  Satış Masrafları</span><span style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
  <p class=MsoNormal><span style='font-size:9.0pt;mso-bidi-font-size:12.0pt'>12)
  Müteferrik</span><span style='font-size:9.0pt;mso-bidi-font-size:10.0pt'><o:p></o:p></span></p>
