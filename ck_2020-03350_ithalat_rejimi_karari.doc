data-tooltip='BKK 2016-9611 İthalat Rejimi Kararına Ek Karar' target='_blank' href="https://www.gumrukkulliyati.com/index.php?id=docs/gumruk_mevzuati/dosyalar/ithalat/bkk_2016-9611_ithalat_rejimi_kararina_ek_karar.htm">9611</a>
