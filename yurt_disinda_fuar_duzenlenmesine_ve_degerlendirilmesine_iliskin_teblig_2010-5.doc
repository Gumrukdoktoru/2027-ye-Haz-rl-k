 <tr style='mso-yfti-irow:24;height:18.65pt'>
  <td colspan=2 valign=bottom style='border:dotted windowtext 1.0pt;border-top:
  none;mso-border-top-alt:dotted windowtext .25pt;mso-border-alt:dotted windowtext .25pt;
  padding:0cm 0cm 0cm 0cm;height:18.65pt'>
  <p class=MsoNormal><span style='font-size:10.0pt'>DEĞERLENDİRMEDE HER SORU
  8'ER PUAN, NAKLİYE HİZMETİ ALINMAMIŞSA 1-4 SORULAR 10'AR PUAN ESAS ALINIR.</span><span
  style='font-size:10.0pt;mso-fareast-font-family:"Arial Unicode MS"'><o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:25;height:18.65pt'>
  <td colspan=2 valign=bottom style='border:dotted windowtext 1.0pt;border-top:
  none;mso-border-top-alt:dotted windowtext .25pt;mso-border-alt:dotted windowtext .25pt;
  padding:0cm 0cm 0cm 0cm;height:18.65pt'>
  <p class=MsoNormal><span style='font-size:10.0pt'>GÖRÜŞ VE ÖNERİLERİNİZ İÇİN
  ARKA SAYFADAKİ BOŞ ALANI KULLANABİLİRSİNİZ.</span><span style='font-size:
  10.0pt;mso-fareast-font-family:"Arial Unicode MS"'><o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:26;height:18.65pt'>
  <td colspan=2 valign=bottom style='border:dotted windowtext 1.0pt;border-top:
  none;mso-border-top-alt:dotted windowtext .25pt;mso-border-alt:dotted windowtext .25pt;
  padding:0cm 0cm 0cm 0cm;height:18.65pt'>
  <p class=MsoNormal><b><span style='font-size:10.0pt'>NOT:</span></b><span
  style='font-size:10.0pt'> BU FORMU DOLDURMAYAN FİRMALARIN DESTEK TALEPLERİ
  DEĞERLENDİRİLMEYECEKTİR.</span><span style='font-size:10.0pt;mso-fareast-font-family:
  "Arial Unicode MS"'><o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:27;height:12.85pt'>
  <td nowrap colspan=2 valign=bottom style='border:dotted windowtext 1.0pt;
  border-top:none;mso-border-top-alt:dotted windowtext .25pt;mso-border-alt:
  dotted windowtext .25pt;padding:0cm 0cm 0cm 0cm;height:12.85pt'>
  <p class=MsoNormal><span style='font-size:10.0pt;mso-fareast-font-family:
  "Arial Unicode MS"'><o:p> </o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:28;mso-yfti-lastrow:yes;height:12.85pt'>
  <td nowrap colspan=2 valign=bottom style='border:dotted windowtext 1.0pt;
  border-top:none;mso-border-top-alt:dotted windowtext .25pt;mso-border-alt:
  dotted windowtext .25pt;padding:0cm 0cm 0cm 0cm;height:12.85pt'>
  <p class=MsoNormal align=center style='text-align:center'><b><span
  style='font-size:10.0pt'>FORMU DOLDURAN FİRMA YETKİLİSİ İSİM /İMZA:</span></b><b><span
  style='font-size:10.0pt;mso-fareast-font-family:"Arial Unicode MS"'><o:p></o:p></span></b></p>
  </td>
 </tr>
