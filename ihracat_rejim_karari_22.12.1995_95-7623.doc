data-tooltip='RYKGM 2016-13 İhracatta yerinde gümrükleme ve izinli gönderici işlemleri' target='_blank' href="https://www.gumrukkulliyati.com/index.php?id=docs/gumruk_mevzuati/dosyalar/genelgeler/rykgm_2016-13_ihracatta_yerinde_gumrukleme_ve_izinli_gonderici_islemleri.htm"><span
